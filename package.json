{
  "name": "cargoclear-kz",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @cargoclear/web",
    "build:web": "npm run build -w @cargoclear/web",
    "test": "npm test -w @cargoclear/core && npm test -w @cargoclear/web",
    "seed": "node packages/core/scripts/generate-seed.mjs",
    "check:i18n": "node packages/core/scripts/check-i18n.mjs",
    "test:core": "npm test -w @cargoclear/core",
    "test:web": "npm test -w @cargoclear/web"
  }
}
